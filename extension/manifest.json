{
  "manifest_version": 3,
  "name": "ViDow Browser-Helper (Stream-Sniffer & Ad-Skipper)",
  "version": "1.1.0",
  "description": "Erkennt echte Video-Streams (.m3u8/.mpd/.mp4), filtert Pre-Roll-Werbung heraus und sendet Videos mit 1 Klick an dein lokales ViDow.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "An ViDow senden",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
